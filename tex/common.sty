% Semester based timestamping
\RequirePackage{datenumber}
\RequirePackage{ifthen}

\newcommand{\week}[2][]{%
    \setdatenumber{2026}{02}{16}% Semester one, 2026 O-Week
    \ifnum#2>6% Cater for mid-semester break
        \addtocounter{datenumber}{\the\numexpr(#2+1)*7}%
    \else 
        \addtocounter{datenumber}{\the\numexpr#2*7}%
    \fi
    \ifthenelse{\equal{#1}{practical}}%
    {\addtocounter{datenumber}{1}}%
    {}%
    \ifthenelse{\equal{#1}{tutorial}}%
    {\addtocounter{datenumber}{1}}%
    {}%
    \setdatebynumber{\thedatenumber}%
    \datedate
}

% Last updated timestamp based on file mod date
% Useful so students know if content has changed since they read it
\newif\iflastupdated
\lastupdatedtrue

\RequirePackage{xstring}

% Helper macros to extract exact string slices
\def\FormatDate#1#2#3#4#5#6#7#8#9\relax{#1#2#3#4/#5#6/#7#8}
\def\StripD D:#1\relax{\FormatDate#1\relax}

\newcommand{\lastmodified}{%
    % Fetch the raw date string from the compiler engine
    \edef\rawdate{\pdffilemoddate{\CurrentFile}}%
    % Check if the engine returned an empty value
    \ifx\rawdate\empty
        \today% Fallback if the file cannot be read
    \else
        % Slice the string safely: Year (chars 3-6), Month (chars 7-8), Day (chars 9-10)
        \StrMid{\rawdate}{3}{6}/\StrMid{\rawdate}{7}{8}/\StrMid{\rawdate}{9}{10}%
    \fi
}
